# CampusPool — environment template.
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ---- Razorpay: TEST MODE ONLY ----
# Get these from dashboard.razorpay.com with the Test Mode toggle ON.
# key_id MUST start with rzp_test_ — config.py refuses to start otherwise.
# Leave blank until Phase 5; the app runs fine without them before that.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Local LLM (Ollama) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- Database ----
DATABASE_URL=sqlite:///./campuspool_demo.db

# ---- App ----
# DEBUG=true enables /debug/* routes (fake payment settle). MUST be false once
# real Razorpay is wired in Phase 5.
DEBUG=true

# Recommended on Windows when the project folder is inside OneDrive/Dropbox:
# keep the SQLite file OUTSIDE the synced folder, or the sync client's file
# locks surface as "database is locked" mid-request. Any path works; the
# directory is created on startup if missing.
# DATABASE_URL=sqlite:///C:/campuspool_data/campuspool_demo.db
